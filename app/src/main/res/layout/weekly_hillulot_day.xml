<?xml version="1.0" encoding="utf-8"?>
<!-- One day in the weekly hillulot grid: the day on the left, stretched down beside that day's hillulot (like a rowspan). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="@drawable/border">

    <TextView
        android:id="@+id/weeklyHillulotDay"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="4dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:background="@drawable/border"
        tools:text="Sun 25\n14 Ḥesh" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/weeklyHillulotDayRV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:nestedScrollingEnabled="false" />

</LinearLayout>
